#!/usr/bin/env sh

while read local_ref local_oid remote_ref remote_oid
do
    if [ "$remote_ref" = "refs/heads/main" ] && [ "${ALLOW_MAIN_PUSH:-}" != "1" ]; then
        echo "Direct pushes to main are blocked by the repository pre-push hook." >&2
        echo "Push an agent branch and use a pull request." >&2
        echo "For a verified human emergency only, set ALLOW_MAIN_PUSH=1 for one command." >&2
        exit 1
    fi
done

exit 0
